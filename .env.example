# Backend (server/index.ts)
PORT=3001
# Producción: Turso (SQLite en la nube). Sin esto usa el archivo local DB_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DB_PATH=factura-ia.db
# Obligatorio en producción, mínimo 32 caracteres: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Opcional: IA con Claude desde el servidor (la llave nunca llega al navegador)
ANTHROPIC_API_KEY=
LIMITE_IA=30
# Datos del negocio que no van en el código público
EMISOR_NOMBRE=Connexa S.A.S.
EMISOR_EMAIL=
# Botón "Escríbeme" directo a WhatsApp (solo humanos). El número vive solo aquí.
CONTACTO_WHATSAPP=
CONTACTO_NOMBRE=
# Opcional: Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Correo de facturas (Brevo, plan gratis 300 correos/día)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Orígenes permitidos para CORS, separados por coma
CORS_ORIGINS=

# Frontend (Vite): URL del backend si está en otro dominio
VITE_API_URL=
