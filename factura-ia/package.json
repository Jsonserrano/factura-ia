{
  "name": "factura-ia",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/index.ts",
    "dev:full": "concurrently -n web,api -c green,cyan \"npm:dev\" \"npm:dev:api\"",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "npm run build && NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "concurrently": "^10.0.7",
    "fast-xml-parser": "^5.12.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "description": "Facturador de venta para Colombia: CUFE SHA-384, QR DIAN, XML UBL 2.1, WhatsApp, IA y API con usuarios.",
  "engines": {
    "node": ">=22.13"
  }
}
